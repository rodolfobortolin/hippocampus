{
  "name": "hipocampo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "O seu Mac vira mem\u00f3ria: coleta local, gr\u00e1ficos e conversa sobre o seu dia.",
  "main": "app/main.cjs",
  "scripts": {
    "build:native": "sh scripts/build-native.sh",
    "dev": "concurrently -k -n core,ui -c magenta,white \"npm:dev:core\" \"npm:dev:ui\"",
    "dev:core": "tsx watch core/index.ts",
    "dev:ui": "vite",
    "dev:app": "concurrently -k -n core,ui,app -c magenta,white,cyan \"npm:dev:core\" \"npm:dev:ui\" \"npm:dev:shell\"",
    "dev:shell": "HIPOCAMPO_DEV=1 electron app/main.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning core/index.ts",
    "collector": "node --experimental-strip-types --disable-warning=ExperimentalWarning core/collector.ts",
    "rollup": "node --experimental-strip-types --disable-warning=ExperimentalWarning core/rollup.ts",
    "install:agent": "sh scripts/agent.sh install",
    "permissao": "sh scripts/permissao.sh",
    "ouvido": "sh scripts/ouvido.sh ligar",
    "ouvido:off": "sh scripts/ouvido.sh desligar",
    "uninstall:agent": "sh scripts/agent.sh uninstall",
    "logs": "tail -f ~/Library/Logs/Hipocampo/collector.log",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"testes/*.test.ts\"",
    "dist": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
