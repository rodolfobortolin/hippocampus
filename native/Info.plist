<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Hippocampus Focus</string>
  <key>CFBundleDisplayName</key><string>Hippocampus Focus</string>
  <key>CFBundleIdentifier</key><string>com.hippocampus.focus</string>
  <key>CFBundleExecutable</key><string>hippocampus-focus</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>hippocampus</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- Agente: não aparece no Dock nem no alternador de apps.
       Sem LSBackgroundOnly de propósito: app marcado como "somente segundo
       plano" é tratado à parte pelo TCC e não segura bem a Acessibilidade.
       LSUIElement sozinho é o que usam os utilitários de barra de menus que
       precisam dessa permissão. -->
  <key>LSUIElement</key><true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>O Hippocampus pergunta ao sistema se algum microfone está em uso, para reconhecer uma chamada sem depender de identificar o app. Ele não grava áudio.</string>
  <key>NSAccessibilityUsageDescription</key>
  <string>O Hippocampus lê o título da janela em foco para saber em que você está trabalhando. Nada sai desta máquina.</string>
</dict>
</plist>
