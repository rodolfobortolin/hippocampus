<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Hippocampus Focus</string>
  <key>CFBundleDisplayName</key><string>Hippocampus Focus</string>
  <key>CFBundleIdentifier</key><string>com.hippocampus.focus</string>
  <key>CFBundleExecutable</key><string>hippocampus-focus</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>hippocampus</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <!-- An agent: it appears neither in the Dock nor in the app switcher.
       No LSBackgroundOnly, on purpose: an app marked "background only" is
       handled apart by the TCC and does not hold Accessibility well.
       LSUIElement on its own is what the menu bar utilities that need this
       permission use. -->
  <key>LSUIElement</key><true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>Hippocampus asks the system whether any microphone is in use, to recognise a call without having to identify the app. It records no audio.</string>
  <!-- Asked only after the Calendar switch is turned on in the app. -->
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Hippocampus reads the names and times of your meetings to name the calls it already measures. They are stored only on this Mac.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Hippocampus reads the names and times of your meetings to name the calls it already measures. They are stored only on this Mac.</string>
  <key>NSAccessibilityUsageDescription</key>
  <string>Hippocampus reads the focused window's title to know what you are working on. It is stored only on this Mac.</string>
</dict>
</plist>
