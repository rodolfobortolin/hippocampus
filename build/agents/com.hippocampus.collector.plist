<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hippocampus.collector</string>
  <!-- A path relative to the bundle: that is what makes the agent belong to
       the app rather than point at a place on disk that can disappear. Each
       launcher handles its own log, because a plist inside a bundle is static
       and launchd does not expand $HOME. -->
  <key>BundleProgram</key><string>Contents/Resources/scripts/launch-core.sh</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
