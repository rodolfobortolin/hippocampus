<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles at runtime; without the first three, Electron does not start
       under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The core starts with ELECTRON_RUN_AS_NODE=1. A variable that affects
       dyld is blocked under the hardened runtime, and without this the process
       simply never comes up — no error, no log, only a collector that never
       answers. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- The local API on 127.0.0.1, jev, and OpenAI's voice. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- The wake-word listener and the spoken question. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Asking Spotify, Music and the browser what is playing. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
