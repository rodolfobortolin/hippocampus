# Tudo isto é opcional e serve para desenvolvimento: dentro do app, a tela de
# Ajustes guarda as mesmas coisas — o idioma, o nome, o vault e a hora em que o
# dia vira — no próprio banco, e as duas chaves no Chaveiro do macOS. O que está
# no Chaveiro vence o que está aqui.
#
# Este arquivo é ignorado pelo git. Sem chave nenhuma o app ainda mede, desenha
# e guarda tudo; só a narrativa, a conversa e a classificação ficam desligadas.

# pt-BR | en-US | es-ES | fr-FR | de-DE
HIPOCAMPO_LANG=en-US
HIPOCAMPO_USER=
HIPOCAMPO_DAY_START=4
HIPOCAMPO_VAULT=~/Documents/Obsidian
HIPOCAMPO_CODE=~/Documents/GitHub

# jev (TypeSafe) — classifica cada janela em categoria, projeto e foco.
TYPESAFE_API_KEY=

# OpenAI — só para a voz. A conversa é sempre Claude Code, pelo seu login.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
