# All of this is optional, and mostly useful in development: inside the app the
# Settings screen keeps the same things — the language, the name, the vault and
# the hour the day turns over — in the database itself, and the two keys in the
# macOS Keychain. What is in the Keychain wins over what is here.
#
# This file is ignored by git. With no key at all the app still measures, draws
# and stores everything; only the narrative, the conversation and the
# classification stay switched off.

# pt-BR | en-US | es-ES | fr-FR | de-DE
HIPPOCAMPUS_LANG=en-US
HIPPOCAMPUS_USER=
HIPPOCAMPUS_DAY_START=4
HIPPOCAMPUS_VAULT=~/Documents/Obsidian
HIPPOCAMPUS_CODE=~/Documents/GitHub

# jev (TypeSafe) — classifies each window into category, project and focus.
TYPESAFE_API_KEY=

# OpenAI — for the voice only. The conversation is always Claude Code, through
# your own login.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
