node_modules/
dist/
.env
.DS_Store
*.log

# Build output: the native bundles are signed with the Developer ID of whoever
# compiles them, so versioning them makes no sense — each person builds their
# `npm run build:native`.
native/*.app/
native/hippocampus-focus
native/hippocampus-listener
# Only what comes out of the compiler. The rest of build/ is source: the
# entitlements, the agent plists and the hook that signs the registrar.
build/*.icns
build/*.iconset/
build/icon-*.png

# The signed bundle: it comes out of `npm run dist`, signed by whoever builds.
release/
native/bin/
public/intro.mp4
