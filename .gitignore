node_modules/
dist/
.env
.DS_Store
*.log

# Resultado de compilação: os bundles nativos são assinados com o Developer ID
# de quem compila, então não fazem sentido versionados — cada um gera o seu com
# `npm run build:native`.
native/*.app/
native/hipocampo-focus
native/hipocampo-ouvido
# Só o que sai do compilador. O resto de build/ é fonte: os entitlements, os
# plists dos agentes e o hook que assina o registrador.
build/*.icns
build/*.iconset/
build/icone-*.png

# Bundle assinado: sai do `npm run dist`, e a assinatura é de quem compila.
release/
native/bin/
public/intro.mp4
